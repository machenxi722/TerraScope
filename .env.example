# Run scripts/configure.py to create a local .env with a random password.
TERRA_ADMIN_USERNAME=admin
TERRA_ADMIN_PASSWORD=replace-with-at-least-12-characters
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
TERRA_SECURE_COOKIES=false
WEB_PORT=8080
# HTTPS by default; ssh_tunnel permits only http://127.0.0.1:<port>.
TERRA_MODEL_SERVICE_URL=
TERRA_MODEL_SERVICE_TOKEN=
TERRA_MODEL_TRANSPORT=https
